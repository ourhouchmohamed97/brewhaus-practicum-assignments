# Copy this file to .env and fill in your real Neon connection string.
# NEVER commit the real .env - it is in .gitignore.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
SESSION_SECRET=replace-with-a-long-random-secret

# Client URL for CORS and Stripe redirect URLs
CLIENT_URL=http://localhost:5173

# Stripe API keys (get from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe redirect URLs (used in Checkout Session)
STRIPE_SUCCESS_URL=http://localhost:5173/checkout/success
STRIPE_CANCEL_URL=http://localhost:5173/checkout/cancel

PORT=5000
NODE_ENV=development